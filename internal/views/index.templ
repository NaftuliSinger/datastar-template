package views

templ Index() {
    <h1 class="mb-2 text-3xl font-bold">Hi</h1>
    <p class="text-gray-600">Welcome to Datastar Template with Golang, Sqlc and Templ.</p>

    <div class="mt-6 flex flex-wrap gap-3">
        <a href="/todos" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
            Todos
        </a>

        <a href="/crypto" class="rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">
            Realtime Crypto Prices
        </a>
    </div>
}
